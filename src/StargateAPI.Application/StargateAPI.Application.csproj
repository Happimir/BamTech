<Project Sdk="Microsoft.NET.Sdk">

  <!-- Use cases (MediatR handlers), DTOs and the persistence abstractions they need.
       References only the Domain. EF Core's general API is allowed; SQLite is not. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StargateAPI.Domain\StargateAPI.Domain.csproj" />
  </ItemGroup>

</Project>
