<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The API host and composition root: controllers, HTTP middleware, sign-in and security.
       Business endpoints reach the use cases through MediatR; Infrastructure is referenced
       for wiring and for the ASP.NET Identity/session plumbing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypeScriptModuleKind>none</TypeScriptModuleKind>
    <UserSecretsId>2b155f9b-c4a2-477c-882a-152d439544e4</UserSecretsId>
    <!-- Hot Chocolate's global usings (HotChocolate, GreenDonut) clash with the domain's Result and
         ErrorCodes; GraphQL files import what they use. -->
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
    <!-- XML doc comments become the GraphQL schema's descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.9" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.6.9" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.9" />
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="16.6.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StargateAPI.Application\StargateAPI.Application.csproj" />
    <ProjectReference Include="..\StargateAPI.Infrastructure\StargateAPI.Infrastructure.csproj" />
  </ItemGroup>

</Project>
